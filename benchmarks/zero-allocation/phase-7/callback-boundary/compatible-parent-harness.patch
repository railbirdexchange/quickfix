new file mode 100644
index 00000000..67cbdbfe
--- /dev/null
+++ b/bounded_session_lifecycle_test.go
@@ -0,0 +1,250 @@
+package quickfix
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// OnLogout precedes writer join and inbound drain. The owner must accept a
+// subsequent admin command before the disconnected fixture inspects live data.
+func boundedLifecycleOwnerBarrier(t *testing.T, s *session) {
+	t.Helper()
+	require.NoError(t, boundedLifecycleBarrier(s))
+}
+func boundedLifecycleBarrier(s *session) error {
+	reply := make(chan waitChan)
+	select {
+	case s.admin <- waitForInSessionReq{rep: reply}:
+	case <-time.After(10 * time.Second):
+		return errors.New("session owner did not accept teardown barrier")
+	}
+	select {
+	case _, waiting := <-reply:
+		if waiting {
+			return errors.New("lifecycle fixture unexpectedly left session time")
+		}
+	case <-time.After(10 * time.Second):
+		return errors.New("session owner did not complete teardown barrier")
+	}
+	return nil
+}
+func (f *boundedFullSession) disconnect() error {
+	if f.peer != nil {
+		_ = f.peer.Close()
+	}
+	select {
+	case <-f.application.logouts:
+	case <-time.After(10 * time.Second):
+		return errors.New("full session did not observe disconnect")
+	}
+	if err := boundedLifecycleBarrier(f.session); err != nil {
+		return err
+	}
+	if f.session.IsConnected() || f.session.readConnection != nil || f.session.messageIn != nil || f.session.writeConnection != nil {
+		return errBoundedFullFixture
+	}
+	if len(f.session.boundedIn.ring.vacant) != len(f.session.boundedIn.ring.slots) || len(f.session.outbound.vacant) != len(f.session.outbound.slots) {
+		return errBoundedFullFixture
+	}
+	return nil
+}
+func (f *boundedFullSession) reconnect() error {
+	if err := f.disconnect(); err != nil {
+		return err
+	}
+	return f.connect()
+}
+func assertBoundedLifecycleDisconnected(t *testing.T, s *session) {
+	t.Helper()
+	boundedLifecycleOwnerBarrier(t, s)
+	require.False(t, s.IsConnected())
+	require.Nil(t, s.readConnection)
+	require.Nil(t, s.writeConnection)
+	require.Nil(t, s.messageIn)
+	assertInboundRingVacant(t, s.boundedIn.ring)
+	require.Equal(t, len(s.outbound.slots), len(s.outbound.vacant))
+}
+
+// Only an explicitly armed Write is delayed. All successful writes still go
+// through real TCP. Channels transfer the gate decision without a new hot lock.
+type boundedLifecycleWriteGate struct {
+	net.Conn
+	armed, entered chan struct{}
+	decision       chan error
+	cancel         chan struct{}
+}
+
+func newBoundedLifecycleWriteGate(connection net.Conn) *boundedLifecycleWriteGate {
+	return &boundedLifecycleWriteGate{Conn: connection, armed: make(chan struct{}, 1), entered: make(chan struct{}, 1), decision: make(chan error, 1), cancel: make(chan struct{})}
+}
+func (gate *boundedLifecycleWriteGate) Write(wire []byte) (int, error) {
+	select {
+	case <-gate.armed:
+		select {
+		case gate.entered <- struct{}{}:
+		case <-gate.cancel:
+			return 0, io.ErrClosedPipe
+		}
+		select {
+		case err := <-gate.decision:
+			if err != nil {
+				return 0, err
+			}
+		case <-gate.cancel:
+			return 0, io.ErrClosedPipe
+		}
+	default:
+	}
+	return gate.Conn.Write(wire)
+}
+
+func TestBoundedSessionLifecycleRetainedJournalAfterTCPReset(t *testing.T) {
+	f := newBoundedFullSession(t, true)
+	require.NoError(t, f.sendOrder(f.sendSequence))
+	report, err := f.readReport()
+	require.NoError(t, err)
+	sequence, reject := report.Header.GetInt(tagMsgSeqNum)
+	require.Nil(t, reject)
+	original, reject := report.Header.GetBytes(tagSendingTime)
+	require.Nil(t, reject)
+	savedTime, savedBody := bytes.Clone(original), bytes.Clone(report.bodyBytes)
+	// Completed delivery is not the explicit retention acknowledgement.
+	require.NoError(t, f.peer.SetLinger(0))
+	require.NoError(t, f.disconnect())
+	assertBoundedLifecycleDisconnected(t, f.session)
+	store := f.session.store.(*BoundedStore)
+	retained, ok := store.message(sequence)
+	require.True(t, ok)
+	savedWire := bytes.Clone(retained)
+	nextSender, nextTarget := store.NextSenderMsgSeqNum(), store.NextTargetMsgSeqNum()
+	require.Equal(t, f.receiveSequence, nextSender)
+	require.Equal(t, f.sendSequence, nextTarget)
+	require.NoError(t, f.connectWithAcknowledgement(false))
+	f.prepare("2", f.sendSequence)
+	f.builder.Body().SetInt(tagBeginSeqNo, sequence)
+	f.builder.Body().SetInt(tagEndSeqNo, sequence)
+	require.NoError(t, f.writePrepared())
+	f.sendSequence++
+	replay, err := f.readReport()
+	require.NoError(t, err)
+	actual, reject := replay.Header.GetInt(tagMsgSeqNum)
+	require.Nil(t, reject)
+	require.Equal(t, sequence, actual)
+	duplicate, reject := replay.Header.GetBytes(tagPossDupFlag)
+	require.Nil(t, reject)
+	require.Equal(t, "Y", string(duplicate))
+	replayedTime, reject := replay.Header.GetBytes(tagOrigSendingTime)
+	require.Nil(t, reject)
+	require.Equal(t, savedTime, replayedTime)
+	require.Equal(t, savedBody, replay.bodyBytes)
+	require.NoError(t, f.disconnect())
+	assertBoundedLifecycleDisconnected(t, f.session)
+	retained, ok = store.message(sequence)
+	require.True(t, ok)
+	require.Equal(t, savedWire, retained)
+	require.Equal(t, nextSender+1, store.NextSenderMsgSeqNum(), "only reconnect Logon consumes a new sequence")
+	require.Equal(t, nextTarget+2, store.NextTargetMsgSeqNum())
+	require.NoError(t, f.connectWithAcknowledgement(false))
+	checkpoint, err := f.acknowledge(false)
+	require.NoError(t, err)
+	require.Zero(t, checkpoint.retained)
+	require.NoError(t, f.ordinaryBatch(1, false))
+}
+
+func TestBoundedSessionLifecycleFullOutputFailureIsAtomic(t *testing.T) {
+	f := newBoundedFullSession(t, true)
+	require.NoError(t, f.prepareSlowConsumer())
+	require.NoError(t, f.configure(func(a *boundedFullApplication) { a.session.ResetOnDisconnect = true }))
+	_, blocked, err := f.blockSlowConsumer()
+	require.NoError(t, err)
+	f.slowGate.decision <- io.ErrClosedPipe
+	var failure boundedFullAdmission
+	select {
+	case failure = <-f.application.admissions:
+	case <-f.slowTimer.C:
+		t.Fatal("blocked send did not return after writer failure")
+	}
+	require.ErrorIs(t, failure.err, io.ErrClosedPipe)
+	require.Zero(t, failure.accepted)
+	require.Equal(t, blocked.before, failure.before)
+	require.Equal(t, failure.before, failure.after)
+	select {
+	case <-f.application.preparations:
+		t.Fatal("failed blocked send reached ToApp")
+	default:
+	}
+	require.NoError(t, f.disconnect())
+	assertBoundedLifecycleDisconnected(t, f.session)
+	require.ErrorIs(t, f.writer.err, io.ErrClosedPipe)
+	store := f.session.store.(*BoundedStore)
+	after := fingerprintBoundedFullStore(store)
+	require.Equal(t, failure.before.nextSender, after.nextSender)
+	require.Equal(t, failure.before.digest, after.digest, "ResetOnDisconnect must retain the failed writer's committed prefix")
+	require.Equal(t, 33, after.entries)
+	first, last := store.NextSenderMsgSeqNum()-33, store.NextSenderMsgSeqNum()-1
+	for sequence := first; sequence <= last; sequence++ {
+		wire, exists := store.message(sequence)
+		require.True(t, exists)
+		require.NoError(t, f.peerSlot.Parse(wire))
+		message := f.peerSlot.Message()
+		original, reject := message.Header.GetBytes(tagSendingTime)
+		require.Nil(t, reject)
+		saved := &f.savedReports[sequence-first]
+		saved.sequence = sequence
+		saved.timeLength = copy(saved.timestamp[:], original)
+		saved.body = append(saved.body[:0], message.bodyBytes...)
+	}
+	// No failed-writer response reached the peer. Reconnect accepts the higher
+	// Logon sequence and explicitly requests the recorded missing interval.
+	f.receiveSequence = store.NextSenderMsgSeqNum()
+	f.sendSequence = store.NextTargetMsgSeqNum()
+	require.NoError(t, f.connectWithAcknowledgement(false))
+	f.prepare("2", f.sendSequence)
+	f.builder.Body().SetInt(tagBeginSeqNo, first)
+	f.builder.Body().SetInt(tagEndSeqNo, last)
+	require.NoError(t, f.writePrepared())
+	f.sendSequence++
+	for sequence := first; sequence <= last; sequence++ {
+		replay, err := f.readReport()
+		require.NoError(t, err)
+		actual, reject := replay.Header.GetInt(tagMsgSeqNum)
+		require.Nil(t, reject)
+		require.Equal(t, sequence, actual)
+		duplicate, reject := replay.Header.GetBytes(tagPossDupFlag)
+		require.Nil(t, reject)
+		require.Equal(t, "Y", string(duplicate))
+		original, reject := replay.Header.GetBytes(tagOrigSendingTime)
+		require.Nil(t, reject)
+		saved := &f.savedReports[sequence-first]
+		require.Equal(t, saved.timestamp[:saved.timeLength], original)
+		require.Equal(t, saved.body, replay.bodyBytes)
+	}
+	f.application.commands <- func(a *boundedFullApplication) { a.measureAdmission = false; a.session.ResetOnDisconnect = false }
+	checkpoint, err := f.acknowledge(false)
+	require.NoError(t, err)
+	require.Equal(t, last+2, checkpoint.nextSender)
+	require.Zero(t, checkpoint.retained)
+	require.NoError(t, f.ordinaryBatch(1, false))
+}
+
+func TestBoundedSessionLifecycleFullJournalRefusesReconnect(t *testing.T) {
+	f := newBoundedFullSession(t, true)
+	for range 32 {
+		require.NoError(t, f.unacknowledgedBatch(32))
+	}
+	// Socket completion never evicts journal history to make reconnect room.
+	require.NoError(t, f.disconnect())
+	assertBoundedLifecycleDisconnected(t, f.session)
+	store := f.session.store.(*BoundedStore)
+	before := fingerprintBoundedFullStore(store)
+	require.Equal(t, 1024, before.entries)
+	require.Error(t, f.connectWithAcknowledgement(false))
+	assertBoundedLifecycleDisconnected(t, f.session)
+	require.Equal(t, before, fingerprintBoundedFullStore(store))
+}
diff --git a/scoped_full_session_latency_test.go b/scoped_full_session_latency_test.go
new file mode 100644
index 00000000..ecf68690
--- /dev/null
+++ b/scoped_full_session_latency_test.go
@@ -0,0 +1,205 @@
+package quickfix
+
+import (
+	"net"
+	"slices"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+const ordinaryLatencySampleCapacity = 65536
+
+// The final fixed-size window supplies exact nearest-rank percentiles. Maximum
+// and count cover every measured request, including samples that leave the
+// window. Recording never allocates or grows the backing storage.
+type ordinaryLatencySamples struct {
+	values            []int64
+	next, used, total int
+	maximum           int64
+}
+
+func (samples *ordinaryLatencySamples) record(elapsed time.Duration) {
+	value := int64(elapsed)
+	samples.values[samples.next] = value
+	samples.next++
+	if samples.next == len(samples.values) {
+		samples.next = 0
+	}
+	if samples.used < len(samples.values) {
+		samples.used++
+	}
+	samples.total++
+	if value > samples.maximum {
+		samples.maximum = value
+	}
+}
+
+// Call only after timing stops. Sorting destroys chronological window order;
+// it does not change which samples are represented or allocate another buffer.
+func (samples *ordinaryLatencySamples) percentiles() (p50, p95, p99 int64) {
+	if samples.used == 0 {
+		return 0, 0, 0
+	}
+	window := samples.values[:samples.used]
+	slices.Sort(window)
+	return window[(samples.used*50+99)/100-1], window[(samples.used*95+99)/100-1], window[(samples.used*99+99)/100-1]
+}
+
+type ordinaryRoundTripMeasurement struct {
+	started, completed time.Time
+	err                error
+}
+
+// One measured operation begins before client encoding and ends after the
+// server's owner-side acknowledgement barrier. That barrier flushes pending
+// writes, waits for every output slot to return, and retires only journal data
+// explicitly acknowledged by the peer. Peer parsing, validation, the extra ACK
+// frame and its processing are included. This is not engine-only latency.
+//
+// responseRead is nil in the benchmark. The correctness fixture uses it to
+// demonstrate that receiving the response is earlier than write-slot return.
+func measureOrdinaryFullSessionRoundTrip(fixture *boundedFullSession, responseRead chan<- struct{}) ordinaryRoundTripMeasurement {
+	measurement := ordinaryRoundTripMeasurement{started: time.Now()}
+	measurement.err = fixture.unacknowledgedBatch(1)
+	if measurement.err == nil {
+		if responseRead != nil {
+			responseRead <- struct{}{}
+		}
+		_, measurement.err = fixture.acknowledge(false)
+	}
+	measurement.completed = time.Now()
+	return measurement
+}
+
+// Each op is one application request/response plus the explicit completion ACK,
+// not a batch. Percentiles describe the final min(N, 65536) requests; max covers
+// all N. Default ns/op and requests/s include clock/sample-recording overhead.
+// Setup, warm-up, percentile sorting and shutdown are outside timing.
+func BenchmarkOrdinaryFullSessionRoundTrip(benchmark *testing.B) {
+	for _, scenario := range []struct {
+		name   string
+		groups bool
+	}{{name: "ordinary"}, {name: "groups", groups: true}} {
+		benchmark.Run(scenario.name, func(benchmark *testing.B) {
+			benchmark.StopTimer()
+			fixture := newBoundedFullSession(benchmark, scenario.groups)
+			require.NoError(benchmark, fixture.warm())
+			samples := ordinaryLatencySamples{values: make([]int64, ordinaryLatencySampleCapacity)}
+			benchmark.ReportAllocs()
+			benchmark.ResetTimer()
+			benchmark.StartTimer()
+			for range benchmark.N {
+				measurement := measureOrdinaryFullSessionRoundTrip(fixture, nil)
+				if measurement.err != nil {
+					benchmark.Fatal(measurement.err)
+				}
+				samples.record(measurement.completed.Sub(measurement.started))
+			}
+			benchmark.StopTimer()
+			p50, p95, p99 := samples.percentiles()
+			benchmark.ReportMetric(float64(p50), "p50-ns")
+			benchmark.ReportMetric(float64(p95), "p95-ns")
+			benchmark.ReportMetric(float64(p99), "p99-ns")
+			benchmark.ReportMetric(float64(samples.maximum), "max-ns")
+			benchmark.ReportMetric(float64(samples.used), "latency-samples")
+			benchmark.ReportMetric(float64(samples.total)/benchmark.Elapsed().Seconds(), "requests/s")
+		})
+	}
+}
+
+func TestOrdinaryLatencySamplesKeepBoundedWindowAndGlobalMaximum(t *testing.T) {
+	samples := ordinaryLatencySamples{values: make([]int64, 4)}
+	storage := &samples.values[0]
+	for _, value := range []time.Duration{100, 4, 3, 2, 1, 5} {
+		samples.record(value)
+	}
+	p50, p95, p99 := samples.percentiles()
+	require.Equal(t, int64(2), p50)
+	require.Equal(t, int64(5), p95)
+	require.Equal(t, int64(5), p99)
+	require.Equal(t, int64(100), samples.maximum, "an old outlier must survive window rollover in the global maximum")
+	require.Equal(t, 6, samples.total)
+	require.Equal(t, 4, samples.used)
+	require.Equal(t, 4, cap(samples.values))
+	require.Same(t, storage, &samples.values[0])
+}
+
+// The underlying TCP Write completes first, allowing the peer to receive and
+// validate all response bytes. The wrapper then retains the writer's output
+// slot until release. This proves the timer's end is later than peer receipt.
+type ordinaryLatencyCompletionGate struct {
+	net.Conn
+	armed, written, release chan struct{}
+}
+
+func (gate *ordinaryLatencyCompletionGate) Write(wire []byte) (int, error) {
+	written, err := gate.Conn.Write(wire)
+	if err == nil && written == len(wire) {
+		select {
+		case <-gate.armed:
+			gate.written <- struct{}{}
+			<-gate.release
+		default:
+		}
+	}
+	return written, err
+}
+
+func TestOrdinaryFullSessionLatencyIncludesWriteSlotReturn(t *testing.T) {
+	fixture := newBoundedFullSession(t, true)
+	require.NoError(t, fixture.warm())
+	gate := &ordinaryLatencyCompletionGate{
+		Conn: fixture.server, armed: make(chan struct{}, 1),
+		written: make(chan struct{}, 1), release: make(chan struct{}, 1),
+	}
+	// Cleanup must unblock the writer even when a preceding assertion fails.
+	t.Cleanup(func() {
+		select {
+		case gate.release <- struct{}{}:
+		default:
+		}
+	})
+	require.NoError(t, fixture.configure(func(application *boundedFullApplication) {
+		application.session.writeConnection.connection = gate
+	}))
+	gate.armed <- struct{}{}
+	responseRead := make(chan struct{}, 1)
+	finished := make(chan ordinaryRoundTripMeasurement, 1)
+	go func() { finished <- measureOrdinaryFullSessionRoundTrip(fixture, responseRead) }()
+	deadline := time.NewTimer(10 * time.Second)
+	defer deadline.Stop()
+	select {
+	case <-gate.written:
+	case measurement := <-finished:
+		t.Fatalf("measurement returned before gated write: %v", measurement.err)
+	case <-deadline.C:
+		t.Fatal("TCP writer did not reach completion gate")
+	}
+	select {
+	case <-responseRead:
+	case measurement := <-finished:
+		t.Fatalf("measurement returned before peer validation: %v", measurement.err)
+	case <-deadline.C:
+		t.Fatal("peer did not validate the delivered response")
+	}
+	select {
+	case measurement := <-finished:
+		t.Fatalf("measurement completed while the writer still owned its slot: %v", measurement.err)
+	default:
+	}
+	releasedAt := time.Now()
+	gate.release <- struct{}{}
+	var measurement ordinaryRoundTripMeasurement
+	select {
+	case measurement = <-finished:
+	case <-deadline.C:
+		t.Fatal("measurement did not finish after output-slot release")
+	}
+	require.NoError(t, measurement.err)
+	require.False(t, measurement.started.After(releasedAt))
+	require.False(t, measurement.completed.Before(releasedAt), "latency must include the period after peer receipt while the writer retains its slot")
+	require.Equal(t, 33, fixture.lastCheckpoint.freeOutputs)
+	require.Zero(t, fixture.lastCheckpoint.retained)
+}
diff --git a/scoped_full_session_write_latency_test.go b/scoped_full_session_write_latency_test.go
new file mode 100644
index 00000000..04604f53
--- /dev/null
+++ b/scoped_full_session_write_latency_test.go
@@ -0,0 +1,383 @@
+package quickfix
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+type ordinaryReadToWriteStart struct {
+	received   time.Time
+	identifier int
+}
+
+type ordinaryReadToWriteCompletion struct {
+	ordinaryReadToWriteStart
+	completed time.Time
+	err       error
+}
+
+// Only the TCP writer owns the mutable frame state. The ordinary callback
+// transfers a copied receive time and request identity; the driver receives a
+// copied completion. Channels are allocated once and hold one outstanding
+// request. An intervening admin frame cannot consume that request's sample.
+type ordinaryReadToWriteConnection struct {
+	net.Conn
+	starts      chan ordinaryReadToWriteStart
+	completions chan ordinaryReadToWriteCompletion
+	request     ordinaryReadToWriteStart
+	hasRequest  bool
+	remaining   int
+	measuring   bool
+}
+
+func newOrdinaryReadToWriteConnection(connection net.Conn) *ordinaryReadToWriteConnection {
+	return &ordinaryReadToWriteConnection{
+		Conn: connection, starts: make(chan ordinaryReadToWriteStart, 1),
+		completions: make(chan ordinaryReadToWriteCompletion, 1),
+	}
+}
+
+func ordinaryLatencyWireValue(wire []byte, tag int) []byte {
+	for len(wire) != 0 {
+		end := bytes.IndexByte(wire, 1)
+		if end < 0 {
+			return nil
+		}
+		field := wire[:end]
+		wire = wire[end+1:]
+		equals := bytes.IndexByte(field, '=')
+		if equals < 1 {
+			return nil
+		}
+		fieldTag := 0
+		for _, digit := range field[:equals] {
+			if digit < '0' || digit > '9' {
+				return nil
+			}
+			fieldTag = fieldTag*10 + int(digit-'0')
+		}
+		if fieldTag == tag {
+			return field[equals+1:]
+		}
+	}
+	return nil
+}
+
+func ordinaryLatencyIdentifierEqual(wire []byte, identifier int) bool {
+	if len(wire) == 0 || identifier < 0 {
+		return false
+	}
+	for index := len(wire) - 1; index >= 0; index-- {
+		if wire[index] != '0'+byte(identifier%10) {
+			return false
+		}
+		identifier /= 10
+	}
+	return identifier == 0
+}
+
+func (connection *ordinaryReadToWriteConnection) Write(wire []byte) (int, error) {
+	if connection.remaining == 0 {
+		if !connection.hasRequest {
+			select {
+			case connection.request = <-connection.starts:
+				connection.hasRequest = true
+			default:
+			}
+		}
+		connection.remaining = len(wire)
+		kind := ordinaryLatencyWireValue(wire, 35)
+		connection.measuring = connection.hasRequest && len(kind) == 1 && kind[0] == '8' &&
+			ordinaryLatencyIdentifierEqual(ordinaryLatencyWireValue(wire, 11), connection.request.identifier)
+	}
+
+	written, err := connection.Conn.Write(wire)
+	completed := time.Now() // Immediately after the underlying Write returns.
+	measurementError := err
+	if written < 0 || written > len(wire) {
+		measurementError = io.ErrShortWrite
+	} else if written == 0 && err == nil {
+		measurementError = io.ErrNoProgress
+	} else {
+		connection.remaining -= written
+	}
+	if measurementError != nil || connection.remaining == 0 {
+		if connection.measuring {
+			connection.completions <- ordinaryReadToWriteCompletion{
+				ordinaryReadToWriteStart: connection.request, completed: completed, err: measurementError,
+			}
+			connection.hasRequest = false
+		}
+		connection.remaining = 0
+		connection.measuring = false
+	}
+	// Preserve the underlying result; the production writer retains its normal
+	// partial-write retry and failure behavior.
+	return written, err
+}
+
+func installOrdinaryReadToWriteMeasurement(fixture *boundedFullSession) (*ordinaryReadToWriteConnection, error) {
+	connection := newOrdinaryReadToWriteConnection(fixture.server)
+	err := fixture.configure(func(application *boundedFullApplication) {
+		application.onOrder = func(message *Message) MessageRejectError {
+			identifier, reject := message.Body.GetInt(11)
+			if reject != nil {
+				return reject
+			}
+			connection.starts <- ordinaryReadToWriteStart{received: message.ReceiveTime, identifier: identifier}
+			return application.handleOrder(message)
+		}
+		application.session.writeConnection.connection = connection
+	})
+	return connection, err
+}
+
+// ReceiveTime is parser.lastRead: time.Now immediately after the final socket
+// Read returns, NOT a timestamp taken after ReadMessageInto finishes. With one
+// outstanding request and the previous ACK barrier complete, this includes
+// remaining framing/check/copy work after that Read, inbound queueing, parsing,
+// dictionary/group validation, the ordinary handler, encoding, persistence and
+// writer queue waits through the final successful TCP Write. Network arrival,
+// Read blocking and framing work before the final Read are excluded.
+//
+// The direct interval ends before peer validation and the extra ACK. A sample
+// is nevertheless accepted only after the unchanged RTT helper has validated
+// the response and completed ACK processing, all slot returns and journal
+// retirement. Receive-time copying, identity inspection and channel transfer
+// instrument the measured path; no overhead is subtracted.
+func measureOrdinaryReadToWrite(fixture *boundedFullSession, connection *ordinaryReadToWriteConnection, responseRead chan<- struct{}) (ordinaryRoundTripMeasurement, ordinaryReadToWriteCompletion) {
+	roundTrip := measureOrdinaryFullSessionRoundTrip(fixture, responseRead)
+	var completion ordinaryReadToWriteCompletion
+	if roundTrip.err != nil {
+		return roundTrip, completion
+	}
+	select {
+	case completion = <-connection.completions:
+	default:
+		roundTrip.err = errBoundedFullFixture
+		return roundTrip, completion
+	}
+	if completion.err != nil {
+		roundTrip.err = completion.err
+	} else if completion.received.IsZero() || completion.received.Before(roundTrip.started) ||
+		completion.completed.Before(completion.received) || completion.completed.After(roundTrip.completed) {
+		roundTrip.err = errBoundedFullFixture
+	}
+	return roundTrip, completion
+}
+
+// Keep BenchmarkOrdinaryFullSessionRoundTrip unchanged for historical
+// comparison. This additional fixture reports both directly observed intervals
+// from the same requests, with all instrumentation enabled in both scenarios.
+// Each fixed final-window percentile covers min(N, 65536) requests; maxima cover
+// all N. ns/op and requests/s also include sample recording and the ACK barrier.
+func BenchmarkOrdinaryFullSessionReadToWrite(benchmark *testing.B) {
+	for _, scenario := range []struct {
+		name   string
+		groups bool
+	}{{name: "ordinary"}, {name: "groups", groups: true}} {
+		benchmark.Run(scenario.name, func(benchmark *testing.B) {
+			benchmark.StopTimer()
+			fixture := newBoundedFullSession(benchmark, scenario.groups)
+			require.NoError(benchmark, fixture.warm())
+			connection, err := installOrdinaryReadToWriteMeasurement(fixture)
+			require.NoError(benchmark, err)
+			warm, _ := measureOrdinaryReadToWrite(fixture, connection, nil)
+			require.NoError(benchmark, warm.err)
+			direct := ordinaryLatencySamples{values: make([]int64, ordinaryLatencySampleCapacity)}
+			roundTrips := ordinaryLatencySamples{values: make([]int64, ordinaryLatencySampleCapacity)}
+			benchmark.ReportAllocs()
+			benchmark.ResetTimer()
+			benchmark.StartTimer()
+			for range benchmark.N {
+				roundTrip, completion := measureOrdinaryReadToWrite(fixture, connection, nil)
+				if roundTrip.err != nil {
+					benchmark.Fatal(roundTrip.err)
+				}
+				direct.record(completion.completed.Sub(completion.received))
+				roundTrips.record(roundTrip.completed.Sub(roundTrip.started))
+			}
+			benchmark.StopTimer()
+			p50, p95, p99 := direct.percentiles()
+			benchmark.ReportMetric(float64(p50), "read-write-p50-ns")
+			benchmark.ReportMetric(float64(p95), "read-write-p95-ns")
+			benchmark.ReportMetric(float64(p99), "read-write-p99-ns")
+			benchmark.ReportMetric(float64(direct.maximum), "read-write-max-ns")
+			p50, p95, p99 = roundTrips.percentiles()
+			benchmark.ReportMetric(float64(p50), "rtt-p50-ns")
+			benchmark.ReportMetric(float64(p95), "rtt-p95-ns")
+			benchmark.ReportMetric(float64(p99), "rtt-p99-ns")
+			benchmark.ReportMetric(float64(roundTrips.maximum), "rtt-max-ns")
+			benchmark.ReportMetric(float64(direct.used), "latency-samples")
+			benchmark.ReportMetric(float64(direct.total)/benchmark.Elapsed().Seconds(), "requests/s")
+		})
+	}
+}
+
+// This unit fixture deliberately returns partial writes; the complete TCP
+// qualification below still exercises the production writer and real sockets.
+type ordinaryLatencyPartialConnection struct {
+	net.Conn
+	limit int
+	err   error
+}
+
+func (connection *ordinaryLatencyPartialConnection) Write(wire []byte) (int, error) {
+	return min(connection.limit, len(wire)), connection.err
+}
+
+func TestOrdinaryReadToWritePartialFramesExcludeAdminAndOtherRequests(t *testing.T) {
+	connection := newOrdinaryReadToWriteConnection(&ordinaryLatencyPartialConnection{limit: 7})
+	start := ordinaryReadToWriteStart{received: time.Now(), identifier: 42}
+	connection.starts <- start
+	for _, wire := range [][]byte{
+		[]byte("8=FIX.4.4\x0135=0\x0111=42\x0110=000\x01"),
+		[]byte("8=FIX.4.4\x0135=8\x0111=43\x0110=000\x01"),
+	} {
+		for len(wire) != 0 {
+			written, err := connection.Write(wire)
+			require.NoError(t, err)
+			wire = wire[written:]
+			require.Empty(t, connection.completions, "admin and unrelated responses cannot consume the armed sample")
+		}
+	}
+	wire := []byte("8=FIX.4.4\x0135=8\x0111=42\x0110=000\x01")
+	for len(wire) != 0 {
+		written, err := connection.Write(wire)
+		require.NoError(t, err)
+		wire = wire[written:]
+		if len(wire) != 0 {
+			require.Empty(t, connection.completions, "a partial response is not a completed write")
+		}
+	}
+	completion := <-connection.completions
+	require.NoError(t, completion.err)
+	require.Equal(t, start, completion.ordinaryReadToWriteStart)
+	require.False(t, completion.completed.Before(start.received))
+	require.Empty(t, connection.completions, "exactly one completion belongs to the request")
+}
+
+func TestOrdinaryReadToWriteRejectsFailedWrites(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		limit   int
+		err     error
+		wantErr error
+	}{
+		{name: "no_progress", wantErr: io.ErrNoProgress},
+		{name: "partial_with_error", limit: 7, err: io.ErrClosedPipe, wantErr: io.ErrClosedPipe},
+		{name: "all_bytes_with_error", limit: 1024, err: io.ErrClosedPipe, wantErr: io.ErrClosedPipe},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			connection := newOrdinaryReadToWriteConnection(&ordinaryLatencyPartialConnection{limit: test.limit, err: test.err})
+			connection.starts <- ordinaryReadToWriteStart{received: time.Now(), identifier: 42}
+			wire := []byte("8=FIX.4.4\x0135=8\x0111=42\x0110=000\x01")
+			written, err := connection.Write(wire)
+			require.Equal(t, min(test.limit, len(wire)), written)
+			require.Equal(t, test.err, err, "the wrapper must preserve the result seen by the production writer")
+			completion := <-connection.completions
+			require.ErrorIs(t, completion.err, test.wantErr, "a failed write cannot qualify a successful latency sample")
+		})
+	}
+}
+
+type ordinaryLatencyBeforeWriteGate struct {
+	net.Conn
+	armed, entered, release chan struct{}
+}
+
+func (gate *ordinaryLatencyBeforeWriteGate) Write(wire []byte) (int, error) {
+	select {
+	case <-gate.armed:
+		gate.entered <- struct{}{}
+		<-gate.release
+	default:
+	}
+	return gate.Conn.Write(wire)
+}
+
+func TestOrdinaryReadToWriteIncludesWriterWaitAndQualifiesSlotReturn(t *testing.T) {
+	for _, beforeWrite := range []bool{true, false} {
+		name := "after_write_before_slot_return"
+		if beforeWrite {
+			name = "before_write"
+		}
+		t.Run(name, func(t *testing.T) {
+			fixture := newBoundedFullSession(t, true)
+			require.NoError(t, fixture.warm())
+			connection, err := installOrdinaryReadToWriteMeasurement(fixture)
+			require.NoError(t, err)
+			armed, entered, release := make(chan struct{}, 1), make(chan struct{}, 1), make(chan struct{}, 1)
+			t.Cleanup(func() {
+				select {
+				case release <- struct{}{}:
+				default:
+				}
+			})
+			require.NoError(t, fixture.configure(func(application *boundedFullApplication) {
+				if beforeWrite {
+					connection.Conn = &ordinaryLatencyBeforeWriteGate{Conn: fixture.server, armed: armed, entered: entered, release: release}
+				} else {
+					application.session.writeConnection.connection = &ordinaryLatencyCompletionGate{Conn: connection, armed: armed, written: entered, release: release}
+				}
+			}))
+			armed <- struct{}{}
+			responseRead := make(chan struct{}, 1)
+			type result struct {
+				roundTrip  ordinaryRoundTripMeasurement
+				completion ordinaryReadToWriteCompletion
+			}
+			finished := make(chan result, 1)
+			go func() {
+				roundTrip, completion := measureOrdinaryReadToWrite(fixture, connection, responseRead)
+				finished <- result{roundTrip: roundTrip, completion: completion}
+			}()
+			deadline := time.NewTimer(10 * time.Second)
+			defer deadline.Stop()
+			select {
+			case <-entered:
+			case measurement := <-finished:
+				t.Fatalf("measurement finished before the write gate: %v", measurement.roundTrip.err)
+			case <-deadline.C:
+				t.Fatal("writer did not enter the gate")
+			}
+			if beforeWrite {
+				require.Empty(t, connection.completions)
+			} else {
+				select {
+				case <-responseRead:
+				case <-deadline.C:
+					t.Fatal("peer did not validate the completed TCP response")
+				}
+			}
+			select {
+			case measurement := <-finished:
+				t.Fatalf("sample was accepted before output-slot return: %v", measurement.roundTrip.err)
+			default:
+			}
+			releasedAt := time.Now()
+			release <- struct{}{}
+			var measurement result
+			select {
+			case measurement = <-finished:
+			case <-deadline.C:
+				t.Fatal("measurement did not finish after gate release")
+			}
+			require.NoError(t, measurement.roundTrip.err)
+			require.False(t, measurement.completion.received.After(releasedAt))
+			if beforeWrite {
+				require.False(t, measurement.completion.completed.Before(releasedAt), "direct latency must include the blocked writer")
+			} else {
+				require.False(t, measurement.completion.completed.After(releasedAt), "direct latency ends at actual Write completion, before later slot-return gating")
+			}
+			require.False(t, measurement.roundTrip.completed.Before(releasedAt), "RTT and sample qualification still include slot return and ACK")
+			require.Equal(t, 33, fixture.lastCheckpoint.freeOutputs)
+			require.Zero(t, fixture.lastCheckpoint.retained)
+		})
+	}
+}
