+//go:build !race
+
+package quickfix
+
+import (
+	"runtime"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Allocation measurement is separate from the race-instrumented correctness
+// fixtures, which exercise these same TCP flows. ReadMemStats totals detect even
+// one allocation across the interval; per-operation rounded reports cannot.
+func TestBoundedFullSessionExactAllocations(t *testing.T) {
+	previous := runtime.GOMAXPROCS(1)
+	defer runtime.GOMAXPROCS(previous)
+	for _, scenario := range []string{"ordinary", "groups", "outbound_resend", "inbound_gap", "slow_consumer", "warmed_post_reconnect", "heartbeat_test_request"} {
+		t.Run(scenario, func(t *testing.T) {
+			fixture := newBoundedFullSession(t, scenario != "ordinary")
+			require.NoError(t, fixture.warm())
+			switch scenario {
+			case "slow_consumer":
+				require.NoError(t, fixture.prepareSlowConsumer())
+			case "warmed_post_reconnect":
+				require.NoError(t, fixture.reconnect())
+				require.NoError(t, fixture.warm())
+			}
+			cycle := fixture.scenario(scenario)
+			require.NoError(t, cycle())
+
+			var before, after runtime.MemStats
+			var cycleError error
+			completed := 0
+			runtime.ReadMemStats(&before)
+			for range 100 {
+				if cycleError = cycle(); cycleError != nil {
+					break
+				}
+				completed++
+			}
+			runtime.ReadMemStats(&after)
+
+			allocations, allocatedBytes := after.Mallocs-before.Mallocs, after.TotalAlloc-before.TotalAlloc
+			t.Logf("completed_cycles=%d total_mallocs_delta=%d total_alloc_bytes_delta=%d", completed, allocations, allocatedBytes)
+			require.NoError(t, cycleError)
+			require.Equal(t, 100, completed)
+			require.Zero(t, allocations, "the full warmed interval must have no heap allocation")
+			require.Zero(t, allocatedBytes, "the full warmed interval must allocate no heap bytes")
+		})
+	}
+}
diff --git a/bounded_full_session_peer_test.go b/bounded_full_session_peer_test.go
new file mode 100644
index 00000000..e8de32c7
--- /dev/null
+++ b/bounded_full_session_peer_test.go
@@ -0,0 +1,740 @@
+package quickfix
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/quickfixgo/quickfix/config"
+	"github.com/stretchr/testify/require"
+)
+
+// This peer encoder is test-owned and independent of Message.AppendTo and the
+// session's mutation arena. Every append is bounded before it runs. Thus peer
+// request construction cannot conceal engine allocations in whole-process counts.
+type boundedFullPeerFields struct {
+	wire []byte
+	err  error
+}
+
+func (fields *boundedFullPeerFields) reserve(tag Tag, length int) bool {
+	if fields.err != nil {
+		return false
+	}
+	if length+24 > cap(fields.wire)-len(fields.wire) {
+		fields.err = io.ErrShortBuffer
+		return false
+	}
+	fields.wire = strconv.AppendInt(fields.wire, int64(tag), 10)
+	fields.wire = append(fields.wire, '=')
+	return true
+}
+func (fields *boundedFullPeerFields) SetBytes(tag Tag, value []byte) {
+	if fields.reserve(tag, len(value)) {
+		fields.wire = append(fields.wire, value...)
+		fields.wire = append(fields.wire, 1)
+	}
+}
+func (fields *boundedFullPeerFields) SetString(tag Tag, value string) {
+	if fields.reserve(tag, len(value)) {
+		fields.wire = append(fields.wire, value...)
+		fields.wire = append(fields.wire, 1)
+	}
+}
+func (fields *boundedFullPeerFields) SetInt(tag Tag, value int) {
+	if fields.reserve(tag, 20) {
+		fields.wire = strconv.AppendInt(fields.wire, int64(value), 10)
+		fields.wire = append(fields.wire, 1)
+	}
+}
+func (fields *boundedFullPeerFields) SetTime(tag Tag, value time.Time) {
+	if fields.reserve(tag, 21) {
+		fields.wire = value.AppendFormat(fields.wire, "20060102-15:04:05.000")
+		fields.wire = append(fields.wire, 1)
+	}
+}
+func (fields *boundedFullPeerFields) addParties() {
+	if len(boundedFullPartyWire) > cap(fields.wire)-len(fields.wire) {
+		fields.err = io.ErrShortBuffer
+		return
+	}
+	fields.wire = append(fields.wire, boundedFullPartyWire...)
+}
+
+type boundedFullPeerBuilder struct{ header, body boundedFullPeerFields }
+
+func (builder *boundedFullPeerBuilder) Header() *boundedFullPeerFields { return &builder.header }
+func (builder *boundedFullPeerBuilder) Body() *boundedFullPeerFields   { return &builder.body }
+func (builder *boundedFullPeerBuilder) Reset() {
+	builder.header.wire = builder.header.wire[:0]
+	builder.body.wire = builder.body.wire[:0]
+	builder.header.err = nil
+	builder.body.err = nil
+}
+func (builder *boundedFullPeerBuilder) appendTo(dst []byte) ([]byte, error) {
+	if builder.header.err != nil {
+		return dst, builder.header.err
+	}
+	if builder.body.err != nil {
+		return dst, builder.body.err
+	}
+	length := len(builder.header.wire) + len(builder.body.wire)
+	if length+48 > cap(dst)-len(dst) {
+		return dst, io.ErrShortBuffer
+	}
+	dst = append(dst, "8=FIX.4.4\x019="...)
+	dst = strconv.AppendInt(dst, int64(length), 10)
+	dst = append(dst, 1)
+	dst = append(dst, builder.header.wire...)
+	dst = append(dst, builder.body.wire...)
+	var checksum byte
+	for _, value := range dst {
+		checksum += value
+	}
+	dst = append(dst, '1', '0', '=', '0'+checksum/100, '0'+checksum/10%10, '0'+checksum%10, 1)
+	return dst, nil
+}
+
+type boundedFullSavedReport struct {
+	sequence, timeLength int
+	timestamp            [64]byte
+	body                 []byte
+}
+type boundedFullSession struct {
+	tb                            testing.TB
+	session                       *session
+	application                   *boundedFullApplication
+	peer, server                  *net.TCPConn
+	reader                        *boundedReadConnection
+	writer                        *outboundWriter
+	loopDone                      chan struct{}
+	builder                       boundedFullPeerBuilder
+	peerSlot                      *MessageSlot
+	peerValidator                 *BoundedValidator
+	peerParser                    *parser
+	frame, encoded, savedBody     []byte
+	savedTime                     [64]byte
+	savedTimeLength               int
+	savedReports                  [40]boundedFullSavedReport
+	sendSequence, receiveSequence int
+	bytes                         int64
+	closed                        bool
+	payload                       []byte
+	slowTimer                     *time.Timer
+	slowGate                      *boundedLifecycleWriteGate
+	lastCheckpoint                boundedFullCheckpoint
+	wrapServer                    func(net.Conn) net.Conn
+	socketOutboundBufferSize      int
+}
+
+func newBoundedFullSession(tb testing.TB, groups bool) *boundedFullSession {
+	return newFullSessionWithDelivery(tb, groups, true)
+}
+
+func newFullSessionWithDelivery(tb testing.TB, groups, borrowed bool) *boundedFullSession {
+	tb.Helper()
+	application := &boundedFullApplication{groups: groups, response: newBoundedFullResponse(groups), checkpoints: make(chan boundedFullCheckpoint, 1), logons: make(chan struct{}, 1), logouts: make(chan struct{}, 1), admissions: make(chan boundedFullAdmission, 1), admissionStarts: make(chan boundedFullAdmissionStart, 1), preparations: make(chan boundedFullStoreFingerprint, 1), commands: make(chan func(*boundedFullApplication), 1)}
+	settings := NewSessionSettings()
+	settings.Set(config.DataDictionary, "spec/FIX44.xml")
+	settings.Set(config.TimeStampPrecision, "MILLIS")
+	// Both callback contracts use the same engine and fixed capacities.
+	settings.Set(config.InChanCapacity, "32")
+	settings.Set(config.SocketOutboundBufferSize, "32")
+	settings.Set(config.OutboundFrameQueueCapacity, "32")
+	socketOutboundBufferSize, err := nonNegativeIntSetting(settings, config.SocketOutboundBufferSize)
+	require.NoError(tb, err)
+	var delivery Application = application
+	if borrowed {
+		delivery = BorrowApplication(application)
+	}
+	s, err := (sessionFactory{}).newSession(SessionID{BeginString: BeginStringFIX44, SenderCompID: "SERVER", TargetCompID: "PEER", Qualifier: "ordinary-full-session"}, NewBoundedStoreFactory(1024, 16384), settings, NewNullLogFactory(), delivery)
+	require.NoError(tb, err)
+	require.NoError(tb, registerSession(s))
+	application.session = s
+	limits := DefaultParseLimits()
+	peerSlot, err := NewMessageSlot(nil, s.appDataDictionary, limits)
+	require.NoError(tb, err)
+	validator, err := NewBoundedValidator(defaultValidatorSettings, s.appDataDictionary, nil, limits.MaxFields)
+	require.NoError(tb, err)
+	f := &boundedFullSession{tb: tb, session: s, application: application, loopDone: make(chan struct{}), peerSlot: peerSlot, peerValidator: validator, frame: make([]byte, limits.MaxFrameBytes), encoded: make([]byte, 0, limits.MaxFrameBytes), savedBody: make([]byte, 0, limits.MaxFrameBytes), sendSequence: 1, receiveSequence: 1}
+	f.socketOutboundBufferSize = socketOutboundBufferSize
+	f.builder.header.wire = make([]byte, 0, 1024)
+	f.builder.body.wire = make([]byte, 0, limits.MaxFrameBytes)
+	for index := range f.savedReports {
+		f.savedReports[index].body = make([]byte, 0, limits.MaxFrameBytes)
+	}
+	go func() { s.run(); close(f.loopDone) }()
+	tb.Cleanup(f.close)
+	require.NoError(tb, f.connect())
+	return f
+}
+
+func (f *boundedFullSession) connect() error { return f.connectWithAcknowledgement(true) }
+func (f *boundedFullSession) connectWithAcknowledgement(acknowledge bool) error {
+	listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+	peer, err := net.DialTCP("tcp4", nil, listener.Addr().(*net.TCPAddr))
+	if err != nil {
+		return err
+	}
+	server, err := listener.AcceptTCP()
+	if err != nil {
+		peer.Close()
+		return err
+	}
+	f.peer, f.server = peer, server
+	if err := peer.SetDeadline(time.Now().Add(2 * time.Minute)); err != nil {
+		return err
+	}
+	f.peerParser, err = newBoundedParser(peer, DefaultParseLimits().MaxFrameBytes)
+	if err != nil {
+		return err
+	}
+	var connection net.Conn = server
+	if f.wrapServer != nil {
+		connection = f.wrapServer(server)
+	}
+	s := f.session
+	messageIn := make(chan fixIn, s.InChanCapacity)
+	reader, err := startBoundedRead(connection, newParser(connection), s.boundedIn, messageIn, nil, time.Time{})
+	if err != nil {
+		return err
+	}
+	writer := newOutboundWriter(connection, min(f.socketOutboundBufferSize, len(s.outbound.pending)), s.outbound.writeTimeout, s.messageEvent)
+	f.reader, f.writer = reader, writer
+	go writer.run()
+	if err := s.connectWithIO(messageIn, nil, reader, writer); err != nil {
+		return err
+	}
+	f.prepare("A", f.sendSequence)
+	f.builder.Body().SetString(tagEncryptMethod, "0")
+	f.builder.Body().SetInt(tagHeartBtInt, 60)
+	if err := f.writePrepared(); err != nil {
+		return err
+	}
+	f.sendSequence++
+	message, err := f.readMessage()
+	if err != nil {
+		return err
+	}
+	kind, reject := message.Header.GetBytes(tagMsgType)
+	if reject != nil {
+		return reject
+	}
+	if string(kind) != "A" {
+		return errBoundedFullFixture
+	}
+	<-f.application.logons
+	if !acknowledge {
+		return nil
+	}
+	_, err = f.acknowledge(true)
+	return err
+}
+
+func (f *boundedFullSession) close() {
+	if f.closed {
+		return
+	}
+	f.closed = true
+	if f.slowTimer != nil {
+		f.slowTimer.Stop()
+	}
+	if f.slowGate != nil {
+		close(f.slowGate.cancel)
+	}
+	if f.peer != nil {
+		f.peer.Close()
+	}
+	if f.server != nil {
+		f.server.Close()
+	}
+	f.session.stop()
+	select {
+	case <-f.loopDone:
+	case <-time.After(10 * time.Second):
+		f.tb.Error("full session did not stop after socket closure")
+		return
+	}
+	_ = UnregisterSession(f.session.sessionID)
+	if got, want := len(f.session.outbound.vacant), len(f.session.outbound.slots); got != want {
+		f.tb.Errorf("returned outbound slots = %d, want %d", got, want)
+	}
+	if got, want := len(f.session.boundedIn.ring.vacant), len(f.session.boundedIn.ring.slots); got != want {
+		f.tb.Errorf("returned inbound slots = %d, want %d", got, want)
+	}
+}
+
+func (f *boundedFullSession) prepare(kind string, sequence int) {
+	f.builder.Reset()
+	header := f.builder.Header()
+	header.SetString(tagMsgType, kind)
+	header.SetInt(tagMsgSeqNum, sequence)
+	header.SetString(tagSenderCompID, "PEER")
+	header.SetString(tagTargetCompID, "SERVER")
+	header.SetTime(tagSendingTime, time.Now().UTC())
+}
+
+func (f *boundedFullSession) writePrepared() error {
+	wire, err := f.builder.appendTo(f.encoded[:0])
+	if err != nil {
+		return err
+	}
+	f.bytes += int64(len(wire))
+	for len(wire) != 0 {
+		written, err := f.peer.Write(wire)
+		if err != nil {
+			return err
+		}
+		if written == 0 {
+			return io.ErrNoProgress
+		}
+		wire = wire[written:]
+	}
+	return nil
+}
+
+func (f *boundedFullSession) sendOrder(sequence int) error {
+	return f.sendOrderWithID(sequence, sequence)
+}
+
+func (f *boundedFullSession) sendOrderWithID(sequence, identifier int) error {
+	f.prepare("D", sequence)
+	body := f.builder.Body()
+	body.SetInt(11, identifier)
+	body.SetString(21, "1")
+	body.SetString(55, "SYMABC")
+	body.SetString(54, "1")
+	body.SetInt(38, 1+identifier%97)
+	body.SetString(40, "2")
+	body.SetString(44, "12.50")
+	body.SetTime(60, time.Now().UTC())
+	if f.application.groups {
+		body.addParties()
+	}
+	if f.payload != nil {
+		body.SetBytes(58, f.payload)
+	}
+	if err := f.writePrepared(); err != nil {
+		return err
+	}
+	if sequence == f.sendSequence {
+		f.sendSequence++
+	}
+	return nil
+}
+
+func (f *boundedFullSession) readMessage() (*Message, error) {
+	wire, err := f.peerParser.ReadMessageInto(f.frame[:0])
+	if err != nil {
+		return nil, err
+	}
+	f.bytes += int64(len(wire))
+	if err := f.peerSlot.Parse(wire); err != nil {
+		return nil, err
+	}
+	message := f.peerSlot.Message()
+	if reject, err := f.peerValidator.Validate(message); err != nil {
+		return nil, err
+	} else if reject != nil {
+		return nil, reject
+	}
+	checksum, reject := message.Trailer.GetInt(tagCheckSum)
+	if reject != nil {
+		return nil, reject
+	}
+	var total byte
+	for _, value := range wire[:len(wire)-7] {
+		total += value
+	}
+	first := bytes.IndexByte(wire, 1)
+	second := first + 1 + bytes.IndexByte(wire[first+1:], 1)
+	bodyLength, reject := message.Header.GetInt(tagBodyLength)
+	if reject != nil {
+		return nil, reject
+	}
+	if int(total) != checksum || bodyLength != len(wire)-7-second-1 {
+		return nil, errBoundedFullWire
+	}
+	sequence, reject := message.Header.GetInt(tagMsgSeqNum)
+	if reject != nil {
+		return nil, reject
+	}
+	var duplicate []byte
+	if message.Header.Has(tagPossDupFlag) {
+		duplicate, _ = message.Header.GetBytes(tagPossDupFlag)
+	}
+	if string(duplicate) != "Y" {
+		if sequence != f.receiveSequence {
+			return nil, errBoundedFullFixture
+		}
+		f.receiveSequence++
+	} else if sequence >= f.receiveSequence {
+		return nil, errBoundedFullFixture
+	}
+	return message, nil
+}
+
+func (f *boundedFullSession) readReport() (*Message, error) {
+	message, err := f.readMessage()
+	if err != nil {
+		return nil, err
+	}
+	kind, reject := message.Header.GetBytes(tagMsgType)
+	if reject != nil {
+		return nil, reject
+	}
+	if string(kind) != "8" {
+		return nil, errBoundedFullFixture
+	}
+	id, reject := message.Body.GetInt(11)
+	if reject != nil {
+		return nil, reject
+	}
+	orderID, reject := message.Body.GetInt(37)
+	if reject != nil {
+		return nil, reject
+	}
+	executionID, reject := message.Body.GetInt(17)
+	if reject != nil {
+		return nil, reject
+	}
+	quantity, reject := message.Body.GetInt(38)
+	if reject != nil {
+		return nil, reject
+	}
+	leaves, reject := message.Body.GetInt(151)
+	if reject != nil {
+		return nil, reject
+	}
+	if id != orderID || id != executionID || quantity != 1+id%97 || leaves != quantity {
+		return nil, errBoundedFullFixture
+	}
+	if f.application.groups {
+		if err := boundedFullCheckGroups(message); err != nil {
+			return nil, err
+		}
+	}
+	return message, nil
+}
+
+func (f *boundedFullSession) acknowledge(_ bool) (boundedFullCheckpoint, error) {
+	f.prepare("0", f.sendSequence)
+	f.builder.Header().SetInt(tagLastMsgSeqNumProcessed, f.receiveSequence-1)
+	if err := f.writePrepared(); err != nil {
+		return boundedFullCheckpoint{}, err
+	}
+	f.sendSequence++
+	checkpoint := <-f.application.checkpoints
+	f.lastCheckpoint = checkpoint
+	if checkpoint.err != nil {
+		return checkpoint, checkpoint.err
+	}
+	if checkpoint.nextSender != f.receiveSequence || checkpoint.nextTarget != f.sendSequence-1 || checkpoint.freeOutputs != 33 || checkpoint.retained != 0 {
+		return checkpoint, errBoundedFullFixture
+	}
+	return checkpoint, nil
+}
+
+func (f *boundedFullSession) configure(command func(*boundedFullApplication)) error {
+	f.application.commands <- command
+	_, err := f.acknowledge(false)
+	return err
+}
+func (f *boundedFullSession) ordinaryBatch(count int, rotate bool) error {
+	if err := f.unacknowledgedBatch(count); err != nil {
+		return err
+	}
+	_, err := f.acknowledge(rotate)
+	return err
+}
+func (f *boundedFullSession) unacknowledgedBatch(count int) error {
+	first := f.sendSequence
+	for range count {
+		if err := f.sendOrder(f.sendSequence); err != nil {
+			return err
+		}
+	}
+	for index := 0; index < count; index++ {
+		message, err := f.readReport()
+		if err != nil {
+			return err
+		}
+		identifier, reject := message.Body.GetInt(11)
+		if reject != nil {
+			return reject
+		}
+		if identifier != first+index {
+			return errBoundedFullFixture
+		}
+	}
+	return nil
+}
+
+// Forty retained reports exceed all 33 output slots. Replay must make progress
+// through completed writes without the blocked session owner reclaiming slots.
+func (f *boundedFullSession) outboundResend() error {
+	for index := range f.savedReports {
+		if err := f.sendOrder(f.sendSequence); err != nil {
+			return err
+		}
+		message, err := f.readReport()
+		if err != nil {
+			return err
+		}
+		saved := &f.savedReports[index]
+		saved.sequence, _ = message.Header.GetInt(tagMsgSeqNum)
+		original, _ := message.Header.GetBytes(tagSendingTime)
+		saved.timeLength = copy(saved.timestamp[:], original)
+		saved.body = append(saved.body[:0], message.bodyBytes...)
+	}
+	f.prepare("2", f.sendSequence)
+	f.builder.Body().SetInt(tagBeginSeqNo, f.savedReports[0].sequence)
+	f.builder.Body().SetInt(tagEndSeqNo, f.savedReports[len(f.savedReports)-1].sequence)
+	if err := f.writePrepared(); err != nil {
+		return err
+	}
+	f.sendSequence++
+	for index := range f.savedReports {
+		message, err := f.readReport()
+		if err != nil {
+			return err
+		}
+		saved := &f.savedReports[index]
+		sequence, _ := message.Header.GetInt(tagMsgSeqNum)
+		original, _ := message.Header.GetBytes(tagOrigSendingTime)
+		duplicate, _ := message.Header.GetBytes(tagPossDupFlag)
+		if sequence != saved.sequence || string(duplicate) != "Y" || !bytes.Equal(original, saved.timestamp[:saved.timeLength]) || !bytes.Equal(message.bodyBytes, saved.body) {
+			return errBoundedFullFixture
+		}
+	}
+	_, err := f.acknowledge(false)
+	return err
+}
+
+func (f *boundedFullSession) inboundGap() error {
+	missing := f.sendSequence
+	if err := f.sendOrder(missing + 1); err != nil {
+		return err
+	}
+	request, err := f.readMessage()
+	if err != nil {
+		return err
+	}
+	kind, _ := request.Header.GetBytes(tagMsgType)
+	begin, _ := request.Body.GetInt(tagBeginSeqNo)
+	end, _ := request.Body.GetInt(tagEndSeqNo)
+	if string(kind) != "2" || begin != missing || end != 0 {
+		return errBoundedFullFixture
+	}
+	if err := f.sendOrder(missing); err != nil {
+		return err
+	}
+	f.sendSequence++
+	for expected := missing; expected <= missing+1; expected++ {
+		report, err := f.readReport()
+		if err != nil {
+			return err
+		}
+		identifier, reject := report.Body.GetInt(11)
+		if reject != nil {
+			return reject
+		}
+		if identifier != expected {
+			return errBoundedFullFixture
+		}
+	}
+	_, err = f.acknowledge(false)
+	return err
+}
+
+func (f *boundedFullSession) heartbeatTestRequest() error {
+	f.prepare("1", f.sendSequence)
+	f.builder.Body().SetInt(tagTestReqID, f.sendSequence)
+	requested := f.sendSequence
+	if err := f.writePrepared(); err != nil {
+		return err
+	}
+	f.sendSequence++
+	message, err := f.readMessage()
+	if err != nil {
+		return err
+	}
+	kind, _ := message.Header.GetBytes(tagMsgType)
+	id, reject := message.Body.GetInt(tagTestReqID)
+	if reject != nil {
+		return reject
+	}
+	if string(kind) != "0" || id != requested {
+		return errBoundedFullFixture
+	}
+	_, err = f.acknowledge(false)
+	return err
+}
+
+func (f *boundedFullSession) prepareSlowConsumer() error {
+	f.payload = bytes.Repeat([]byte("x"), 8192)
+	f.slowTimer = time.NewTimer(10 * time.Second)
+	f.slowTimer.Stop()
+	f.slowGate = newBoundedLifecycleWriteGate(f.server)
+	return f.configure(func(a *boundedFullApplication) {
+		a.measureAdmission = true
+		a.session.writeConnection.connection = f.slowGate
+	})
+}
+
+func (f *boundedFullSession) startSlowAdmission() (boundedFullAdmissionStart, error) {
+	if err := f.sendOrder(f.sendSequence); err != nil {
+		return boundedFullAdmissionStart{}, err
+	}
+	select {
+	case attempt := <-f.application.admissionStarts:
+		return attempt, nil
+	case <-f.slowTimer.C:
+		return boundedFullAdmissionStart{}, errBoundedFullFixture
+	}
+}
+
+func (f *boundedFullSession) completeSlowAdmission(attempt boundedFullAdmissionStart) error {
+	var admission boundedFullAdmission
+	select {
+	case admission = <-f.application.admissions:
+	case <-f.slowTimer.C:
+		return errBoundedFullFixture
+	}
+	if admission.err != nil {
+		return admission.err
+	}
+	if admission.accepted != 1 || admission.before != attempt.before || admission.after.nextSender != attempt.before.nextSender+1 {
+		return errBoundedFullFixture
+	}
+	var prepared boundedFullStoreFingerprint
+	select {
+	case prepared = <-f.application.preparations:
+	case <-f.slowTimer.C:
+		return errBoundedFullFixture
+	}
+	// ToApp follows successful output admission and the ordinary journal
+	// reservation. Committed history and both counters must still match the
+	// owner's pre-Send copy, including after a blocked admission resumes.
+	if prepared.reservedIndex < 0 || prepared.reservedSequence != attempt.before.nextSender || prepared.reservedReset {
+		return errBoundedFullFixture
+	}
+	prepared.reservedIndex = attempt.before.reservedIndex
+	prepared.reservedSequence = attempt.before.reservedSequence
+	prepared.reservedReset = attempt.before.reservedReset
+	if prepared != attempt.before {
+		return errBoundedFullFixture
+	}
+	return nil
+}
+
+// The peer owns the gate release independently of the session sending owner.
+// All slots stay occupied until that release. A reusable timer establishes an
+// observed blocked interval; neither ToApp nor SendToTarget may complete in it.
+// Every store observation is copied by the owner, never read concurrently.
+func (f *boundedFullSession) blockSlowConsumer() (int, boundedFullAdmissionStart, error) {
+	f.slowGate.armed <- struct{}{}
+	f.slowTimer.Reset(10 * time.Second)
+	first := f.sendSequence
+	for index := 0; index < 33; index++ {
+		attempt, err := f.startSlowAdmission()
+		if err != nil {
+			return 0, boundedFullAdmissionStart{}, err
+		}
+		if attempt.freeOutputs != 33-index {
+			return 0, boundedFullAdmissionStart{}, errBoundedFullFixture
+		}
+		if err := f.completeSlowAdmission(attempt); err != nil {
+			return 0, boundedFullAdmissionStart{}, err
+		}
+		if index == 0 {
+			select {
+			case <-f.slowGate.entered:
+			case <-f.slowTimer.C:
+				return 0, boundedFullAdmissionStart{}, errBoundedFullFixture
+			}
+		}
+	}
+	attempt, err := f.startSlowAdmission()
+	if err != nil {
+		return 0, boundedFullAdmissionStart{}, err
+	}
+	if attempt.freeOutputs != 0 || attempt.before.reservedIndex != -1 {
+		return 0, boundedFullAdmissionStart{}, errBoundedFullFixture
+	}
+	f.slowTimer.Reset(time.Millisecond)
+	select {
+	case admission := <-f.application.admissions:
+		if admission.err != nil {
+			return 0, boundedFullAdmissionStart{}, admission.err
+		}
+		return 0, boundedFullAdmissionStart{}, errBoundedFullFixture
+	case <-f.application.preparations:
+		return 0, boundedFullAdmissionStart{}, errBoundedFullFixture
+	case <-f.slowTimer.C:
+	}
+	f.slowTimer.Reset(10 * time.Second)
+	return first, attempt, nil
+}
+
+// One response per ordinary request. The gate delays one real TCP Write while
+// the session fills all 33 output slots; request 34 must block before preparation.
+// Release and drain then prove every request completed, with no application retry.
+// The measured cycle includes the deliberate one-millisecond blocked interval.
+func (f *boundedFullSession) slowConsumer() error {
+	first, blocked, err := f.blockSlowConsumer()
+	if err != nil {
+		return err
+	}
+	f.slowGate.decision <- nil
+	if err := f.completeSlowAdmission(blocked); err != nil {
+		return err
+	}
+	for index := 0; index < 34; index++ {
+		report, err := f.readReport()
+		if err != nil {
+			return err
+		}
+		id, _ := report.Body.GetInt(11)
+		value, reject := report.Body.GetBytes(58)
+		if reject != nil {
+			return reject
+		}
+		if id != first+index || !bytes.Equal(value, f.payload) {
+			return errBoundedFullFixture
+		}
+	}
+	f.slowTimer.Stop()
+	_, err = f.acknowledge(false)
+	return err
+}
+
+func (f *boundedFullSession) warm() error {
+	// Fill all 1024 journal cells with real validated responses before retirement.
+	for range 32 {
+		if err := f.unacknowledgedBatch(32); err != nil {
+			return err
+		}
+	}
+	if _, err := f.acknowledge(true); err != nil {
+		return err
+	}
+	// FIFO ownership transfer visits every input/output slot and pushes both
+	// counters beyond integer boxing caches before measurement starts.
+	for range 66 {
+		if err := f.ordinaryBatch(1, true); err != nil {
+			return err
+		}
+	}
+	if err := f.outboundResend(); err != nil {
+		return err
+	}
+	return f.heartbeatTestRequest()
+}
diff --git a/bounded_full_session_test.go b/bounded_full_session_test.go
new file mode 100644
index 00000000..59cf788a
--- /dev/null
+++ b/bounded_full_session_test.go
@@ -0,0 +1,392 @@
+package quickfix
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+var (
+	errBoundedFullFixture = errors.New("quickfix test: unexpected full-session fixture or sequence")
+	errBoundedFullWire    = errors.New("quickfix test: invalid full-session wire framing")
+	boundedFullPartyWire  = []byte("453=1\x01448=party\x01447=D\x01452=1\x01802=1\x01523=sub-party\x01803=1\x01")
+)
+
+// A checkpoint is copied by the session owner after completed writes and explicit
+// peer acknowledgement. The test never observes a concurrently mutated session.
+type boundedFullCheckpoint struct {
+	nextSender, nextTarget         int
+	freeOutputs, retained          int
+	orders, groupReads, queueWaits int
+	err                            error
+}
+
+type boundedFullAdmission struct {
+	accepted      int
+	before, after boundedFullStoreFingerprint
+	err           error
+}
+
+type boundedFullAdmissionStart struct {
+	before      boundedFullStoreFingerprint
+	freeOutputs int
+}
+
+// A fixed-size digest keeps capacity assertions inside measured intervals free
+// of snapshot allocation. It includes every retained byte and both counters.
+type boundedFullStoreFingerprint struct {
+	nextSender, nextTarget, floor, entries int
+	reservedIndex, reservedSequence        int
+	reservedReset                          bool
+	creation                               time.Time
+	digest                                 uint64
+}
+
+func fingerprintBoundedFullStore(store *BoundedStore) boundedFullStoreFingerprint {
+	result := boundedFullStoreFingerprint{nextSender: store.NextSenderMsgSeqNum(), nextTarget: store.NextTargetMsgSeqNum(), floor: store.floor, reservedIndex: store.reservedIndex, reservedSequence: store.reservedSequence, reservedReset: store.reservedReset, creation: store.creationTime, digest: 14695981039346656037}
+	for _, entry := range store.entries {
+		if entry.sequence == 0 {
+			continue
+		}
+		result.entries++
+		result.digest = (result.digest ^ uint64(entry.sequence)) * 1099511628211
+		wire, _ := store.message(entry.sequence)
+		for _, value := range wire {
+			result.digest = (result.digest ^ uint64(value)) * 1099511628211
+		}
+	}
+	return result
+}
+
+type boundedFullReject struct{ err error }
+
+func (e *boundedFullReject) Error() string             { return e.err.Error() }
+func (*boundedFullReject) RejectReason() int           { return 0 }
+func (*boundedFullReject) BusinessRejectRefID() string { return "" }
+func (*boundedFullReject) RefTagID() *Tag              { return nil }
+func (*boundedFullReject) IsBusinessReject() bool      { return false }
+
+type boundedFullApplication struct {
+	session                        *session
+	response                       *Message
+	groups                         bool
+	checkpoints                    chan boundedFullCheckpoint
+	logons, logouts                chan struct{}
+	admissions                     chan boundedFullAdmission
+	admissionStarts                chan boundedFullAdmissionStart
+	preparations                   chan boundedFullStoreFingerprint
+	commands                       chan func(*boundedFullApplication)
+	onOrder                        func(*Message) MessageRejectError
+	orders, groupReads, queueWaits int
+	reportsPerOrder                int
+	measureAdmission               bool
+	observePreparation             bool
+	failure                        boundedFullReject
+}
+
+func (*boundedFullApplication) OnCreate(SessionID)          {}
+func (a *boundedFullApplication) OnLogon(SessionID)         { a.logons <- struct{}{} }
+func (a *boundedFullApplication) OnLogout(SessionID)        { a.logouts <- struct{}{} }
+func (*boundedFullApplication) ToAdmin(*Message, SessionID) {}
+func (a *boundedFullApplication) ToApp(*Message, SessionID) error {
+	if a.observePreparation {
+		// SendToTarget invokes this on the sending owner, after output admission
+		// and journal reservation but before sequence or stored bytes change.
+		a.preparations <- fingerprintBoundedFullStore(a.session.store.(*BoundedStore))
+	}
+	return nil
+}
+func (a *boundedFullApplication) fail(err error) MessageRejectError {
+	a.failure.err = err
+	return &a.failure
+}
+
+func newBoundedFullResponse(groups bool) *Message {
+	message := NewMessage()
+	message.Header.SetString(tagMsgType, "8")
+	for _, field := range []struct {
+		tag   Tag
+		value string
+	}{
+		{150, "0"}, {39, "0"}, {55, "SYMABC"}, {54, "1"}, {14, "0"}, {6, "0"},
+	} {
+		message.Body.SetString(field.tag, field.value)
+	}
+	if groups {
+		subParties := NewRepeatingGroup(802, GroupTemplate{GroupElement(523), GroupElement(803)})
+		subParty := subParties.Add()
+		subParty.SetString(523, "sub-party")
+		subParty.SetInt(803, 1)
+		parties := NewRepeatingGroup(453, GroupTemplate{GroupElement(448), GroupElement(447), GroupElement(452), subParties})
+		party := parties.Add()
+		party.SetString(448, "party")
+		party.SetString(447, "D")
+		party.SetInt(452, 1)
+		party.SetGroup(subParties)
+		message.Body.SetGroup(parties)
+	}
+	return message
+}
+
+// The ordinary count accessor participates in the callback. Exact nested field
+// bytes are checked independently, without a production-only Group API. Legacy
+// GetGroup/SetGroup reconstruction is deliberately not claimed allocation-free.
+func boundedFullCheckGroups(message *Message) error {
+	count, reject := message.Body.GetInt(453)
+	if reject != nil {
+		return reject
+	}
+	if count != 1 || bytes.Count(message.bodyBytes, boundedFullPartyWire) != 1 {
+		return errBoundedFullFixture
+	}
+	return nil
+}
+
+func (a *boundedFullApplication) FromApp(message *Message, _ SessionID) MessageRejectError {
+	if a.onOrder != nil {
+		return a.onOrder(message)
+	}
+	return a.handleOrder(message)
+}
+
+func (a *boundedFullApplication) handleOrder(message *Message) MessageRejectError {
+	accepted := 0
+	var before boundedFullStoreFingerprint
+	for range max(1, a.reportsPerOrder) {
+		if a.measureAdmission {
+			before = fingerprintBoundedFullStore(a.session.store.(*BoundedStore))
+			freeOutputs := len(a.session.outbound.vacant)
+			if freeOutputs == 0 {
+				a.queueWaits++
+			}
+			a.admissionStarts <- boundedFullAdmissionStart{before: before, freeOutputs: freeOutputs}
+		}
+		a.observePreparation = a.measureAdmission
+		reject := a.handleReport(message)
+		a.observePreparation = false
+		if reject != nil {
+			if a.measureAdmission && reject == &a.failure {
+				a.admissions <- boundedFullAdmission{accepted: accepted, before: before, after: fingerprintBoundedFullStore(a.session.store.(*BoundedStore)), err: a.failure.err}
+				// The driver observes ordinary send failures, including a writer
+				// disconnect during capacity backpressure, without a FIX reject.
+				return nil
+			}
+			return reject
+		}
+		accepted++
+	}
+	if a.measureAdmission {
+		a.admissions <- boundedFullAdmission{accepted: accepted, before: before, after: fingerprintBoundedFullStore(a.session.store.(*BoundedStore))}
+	}
+	return nil
+}
+
+func (a *boundedFullApplication) handleReport(message *Message) MessageRejectError {
+	kind, reject := message.Header.GetBytes(tagMsgType)
+	if reject != nil {
+		return reject
+	}
+	if string(kind) != "D" {
+		return a.fail(errBoundedFullFixture)
+	}
+	id, reject := message.Body.GetBytes(11)
+	if reject != nil {
+		return reject
+	}
+	identifier, reject := message.Body.GetInt(11)
+	if reject != nil {
+		return reject
+	}
+	quantity, reject := message.Body.GetInt(38)
+	if reject != nil {
+		return reject
+	}
+	if a.groups {
+		if err := boundedFullCheckGroups(message); err != nil {
+			return a.fail(err)
+		}
+	}
+	// This is the ordinary public API on one caller-owned message. Variable
+	// fields change every request; only static group construction is untimed.
+	body := &a.response.Body
+	body.SetBytes(11, id)
+	body.SetBytes(37, id)
+	body.SetInt(17, identifier)
+	body.SetInt(38, quantity)
+	body.SetInt(151, quantity)
+	if message.Body.Has(58) {
+		value, _ := message.Body.GetBytes(58)
+		body.SetBytes(58, value)
+	} else {
+		body.Remove(58)
+	}
+	if err := SendToTarget(a.response, a.session.sessionID); err != nil {
+		return a.fail(err)
+	}
+	a.orders++
+	if a.groups {
+		a.groupReads++
+	}
+	return nil
+}
+
+func (a *boundedFullApplication) FromAdmin(message *Message, _ SessionID) MessageRejectError {
+	kind, reject := message.Header.GetBytes(tagMsgType)
+	if reject != nil {
+		return reject
+	}
+	if string(kind) != "0" || !message.Header.Has(tagLastMsgSeqNumProcessed) {
+		return nil
+	}
+	acknowledged, reject := message.Header.GetInt(tagLastMsgSeqNumProcessed)
+	if reject != nil {
+		return reject
+	}
+	s := a.session
+	s.resendMutex.RLock()
+	s.sendMutex.Lock()
+	completionError := s.flushOutbound(true)
+	var returned [33]*outboundSlot
+	n := 0
+	if completionError == nil {
+		for n < len(s.outbound.slots) {
+			select {
+			case returned[n] = <-s.outbound.vacant:
+				n++
+			case <-s.writeConnection.done:
+				completionError = s.writeConnection.failure()
+			}
+			if completionError != nil {
+				break
+			}
+		}
+	}
+	for index := 0; index < n; index++ {
+		s.outbound.vacant <- returned[index]
+	}
+	store := s.store.(*BoundedStore)
+	if completionError == nil {
+		completionError = store.RetireBefore(acknowledged + 1)
+	}
+	retained := 0
+	for _, entry := range store.entries {
+		if entry.sequence != 0 {
+			retained++
+		}
+	}
+	checkpoint := boundedFullCheckpoint{nextSender: store.NextSenderMsgSeqNum(), nextTarget: store.NextTargetMsgSeqNum(), freeOutputs: len(s.outbound.vacant), retained: retained, orders: a.orders, groupReads: a.groupReads, queueWaits: a.queueWaits, err: completionError}
+	s.sendMutex.Unlock()
+	s.resendMutex.RUnlock()
+	select {
+	case command := <-a.commands:
+		command(a)
+	default:
+	}
+	a.checkpoints <- checkpoint
+	if completionError != nil {
+		return a.fail(completionError)
+	}
+	return nil
+}
+
+func TestBoundedFullSession(t *testing.T) {
+	for _, groups := range []bool{false, true} {
+		name := "ordinary"
+		if groups {
+			name = "groups"
+		}
+		t.Run(name, func(t *testing.T) {
+			fixture := newBoundedFullSession(t, groups)
+			require.NoError(t, fixture.warm())
+			require.NoError(t, fixture.ordinaryBatch(32, false))
+			require.NoError(t, fixture.outboundResend())
+			require.NoError(t, fixture.inboundGap())
+			require.NoError(t, fixture.heartbeatTestRequest())
+			require.Greater(t, fixture.lastCheckpoint.orders, 1024)
+			if groups {
+				require.Equal(t, fixture.lastCheckpoint.orders, fixture.lastCheckpoint.groupReads)
+			}
+		})
+	}
+}
+
+func TestBoundedFullSessionSlowConsumer(t *testing.T) {
+	fixture := newBoundedFullSession(t, true)
+	require.NoError(t, fixture.warm())
+	require.NoError(t, fixture.prepareSlowConsumer())
+	require.NoError(t, fixture.slowConsumer())
+	require.Greater(t, fixture.lastCheckpoint.queueWaits, 0)
+	require.NoError(t, fixture.slowConsumer())
+}
+
+func TestBoundedFullSessionWarmedPostReconnect(t *testing.T) {
+	fixture := newBoundedFullSession(t, true)
+	require.NoError(t, fixture.warm())
+	before := fixture.lastCheckpoint
+	require.NoError(t, fixture.reconnect())
+	require.NoError(t, fixture.warm())
+	require.NoError(t, fixture.ordinaryBatch(32, false))
+	require.Greater(t, fixture.lastCheckpoint.nextSender, before.nextSender)
+	require.Greater(t, fixture.lastCheckpoint.nextTarget, before.nextTarget)
+}
+
+// Real TCP, dictionary/groups, validation, ordinary callbacks and variable-field
+// construction, persistence, peer validation, completed writes and slot return
+// are timed. Setup and warm-up are excluded. This is not sub-microsecond engine
+// latency: the measurement includes the independent peer and acknowledgement.
+// Ordinary/groups/post-reconnect operations each process a batch of 32 requests.
+func BenchmarkBoundedFullSession(b *testing.B) {
+	benchmarkFullSession(b, true, []string{"ordinary", "groups", "outbound_resend", "inbound_gap", "slow_consumer", "warmed_post_reconnect", "heartbeat_test_request"})
+}
+
+func BenchmarkOwnedFullSession(b *testing.B) {
+	benchmarkFullSession(b, false, []string{"ordinary", "groups"})
+}
+
+func benchmarkFullSession(b *testing.B, borrowed bool, scenarios []string) {
+	for _, scenario := range scenarios {
+		b.Run(scenario, func(b *testing.B) {
+			b.StopTimer()
+			fixture := newFullSessionWithDelivery(b, scenario != "ordinary", borrowed)
+			require.NoError(b, fixture.warm())
+			if scenario == "warmed_post_reconnect" {
+				require.NoError(b, fixture.reconnect())
+				require.NoError(b, fixture.warm())
+			}
+			if scenario == "slow_consumer" {
+				require.NoError(b, fixture.prepareSlowConsumer())
+			}
+			cycle := fixture.scenario(scenario)
+			require.NoError(b, cycle())
+			fixture.bytes = 0
+			b.ReportAllocs()
+			b.ResetTimer()
+			b.StartTimer()
+			for range b.N {
+				if err := cycle(); err != nil {
+					b.Fatal(err)
+				}
+			}
+			b.StopTimer()
+			b.SetBytes(fixture.bytes / int64(b.N))
+		})
+	}
+}
+
+func (f *boundedFullSession) scenario(name string) func() error {
+	switch name {
+	case "outbound_resend":
+		return f.outboundResend
+	case "inbound_gap":
+		return f.inboundGap
+	case "slow_consumer":
+		return f.slowConsumer
+	case "heartbeat_test_request":
+		return f.heartbeatTestRequest
+	default:
+		return func() error { return f.ordinaryBatch(32, false) }
+	}
+}
