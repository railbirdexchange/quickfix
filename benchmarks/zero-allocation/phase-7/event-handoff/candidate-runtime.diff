+// sendPendingAfterIncoming handles one coalesced output hint after the inbound
+// scope has ended. Returning to the main select preserves other event progress.
+func (s *session) sendPendingAfterIncoming() {
+	if s.Stopped() {
+		return
+	}
+	select {
+	case <-s.messageEvent:
+		s.SendAppMessages(s)
+	default:
+	}
